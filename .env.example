# 面试教练 - 服务与模型配置(环境变量优先级高于 config.toml)
# 复制为 .env 后按需修改;也可以直接在 config.toml 或页面「设置」里配置。

# ---------- 服务 ----------
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# 启动后自动打开浏览器(true/false)
AUTO_OPEN_BROWSER=true
# 本地数据目录
DATA_DIR=data

# ---------- 大模型(OpenAI 兼容接口) ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ---------- 面试 ----------
INTERVIEW_TOTAL_QUESTIONS=11
